# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/gyandistro
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/gyandistro?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gyandistro

# ---- Auth (CHANGE THESE BEFORE DEPLOYING) ----
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_access
JWT_REFRESH_SECRET=replace_me_with_a_long_random_string_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=

# ---- AI (optional; leave AI_PROVIDER=none to disable) ----
# none | ollama | openai | anthropic
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- Seed admin ----
SEED_ADMIN_EMAIL=admin@gyandistro.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Image uploads (used by the article body editor) ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Leave blank unless uploaded images need to be served from a different host
# than the API (e.g. a CDN in front of /uploads).
UPLOAD_BASE_URL=
